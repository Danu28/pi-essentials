{
  "name": "pi-essentials",
  "version": "1.3.1",
  "description": "pi core + 1 extension: 5 high-signal tools (intent/plan/memo/intel/check) that make pi Faster, Cheaper, Reliable, Durable. Replaces pi-brain + smart-pi (11 tools -> 5).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "extension",
    "pi",
    "essentials"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danu28/pi-essentials.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run typecheck && npm run lint && npm run test:coverage",
    "lint": "eslint src",
    "size": "npm run build && du -sh dist && ls -lh dist",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "typebox": "^1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "typebox": "^1.3.30",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
